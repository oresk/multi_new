-- 30.09.2024 --
Dankos last day at SOHO. 

Got PWM running, this is the overlay file I did it with:

#include <zephyr/dt-bindings/pwm/pwm.h>


/ {
    aliases {
        pwm-led0 = &pwm_led0;
    };
    pwmleds {
        compatible = "pwm-leds";
        pwm_led0: pwm_led_0 {
            pwms = <&pwm0 1 255 PWM_POLARITY_NORMAL>;
            label = "PWM MB1";
        };
    };
};

&pinctrl {
    pwm0_default: pwm0_default {
        group1 {
            pinmux = <CVI_PINMUX(VIVO_D1, PWM_3)>;  /* B20 */
            pinmux = <CVI_PINMUX(VIVO_D10, PWM_1)>;  /* B11 */
        };
    };
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-names = "default";
};
